diff --git a/tests/test_convrot_activation_cache.py b/tests/test_convrot_activation_cache.py
new file mode 100644
index 0000000..f90d702
--- /dev/null
+++ b/tests/test_convrot_activation_cache.py
@@ -0,0 +1,73 @@
+import gc
+import importlib
+from pathlib import Path
+import sys
+import types
+
+import pytest
+import torch
+
+
+ROOT = Path(__file__).resolve().parents[1]
+PACKAGE = "int8_fast_rocm_cache_tests"
+if PACKAGE not in sys.modules:
+    package = types.ModuleType(PACKAGE)
+    package.__path__ = [str(ROOT)]
+    sys.modules[PACKAGE] = package
+
+cache = importlib.import_module(f"{PACKAGE}.convrot_cache")
+
+
+def _require_rocm():
+    if not torch.cuda.is_available() or torch.version.hip is None:
+        pytest.skip("requires a ROCm GPU")
+
+
+def test_enable_convrot_context_cache_marks_only_to_kv_layers():
+    model = torch.nn.Module()
+    model.blocks = torch.nn.ModuleList()
+    for _ in range(30):
+        block = torch.nn.Module()
+        block.cross_attn = torch.nn.Module()
+        block.cross_attn.to_kv = torch.nn.Linear(16, 32)
+        block.cross_attn.to_kv._use_convrot = True
+        block.cross_attn.to_q = torch.nn.Linear(16, 16)
+        block.cross_attn.to_q._use_convrot = True
+        model.blocks.append(block)
+
+    assert cache.enable_convrot_context_cache(model) == 30
+    assert all(block.cross_attn.to_kv._cache_convrot_activation for block in model.blocks)
+    assert all(not hasattr(block.cross_attn.to_q, "_cache_convrot_activation") for block in model.blocks)
+
+
+def test_convrot_context_cache_hits_replaces_mutated_version_and_releases():
+    _require_rocm()
+    cache.clear_convrot_activation_cache()
+    source = torch.randn(1, 1029, 1024, device="cuda", dtype=torch.bfloat16)
+
+    q1, scale1 = cache.prepare_convrot_activation_cached(source, torch.bfloat16, 256)
+    q2, scale2 = cache.prepare_convrot_activation_cached(source, torch.bfloat16, 256)
+    assert q2.data_ptr() == q1.data_ptr()
+    assert scale2.data_ptr() == scale1.data_ptr()
+    assert cache.convrot_activation_cache_stats() == {"entries": 1, "hits": 1, "misses": 1}
+
+    source.add_(1)
+    q3, _ = cache.prepare_convrot_activation_cached(source, torch.bfloat16, 256)
+    assert q3.data_ptr() != q1.data_ptr()
+    assert cache.convrot_activation_cache_stats() == {"entries": 1, "hits": 1, "misses": 2}
+
+    del source
+    gc.collect()
+    assert cache.convrot_activation_cache_stats()["entries"] == 0
+
+
+def test_convrot_context_cache_supports_inference_tensors():
+    _require_rocm()
+    cache.clear_convrot_activation_cache()
+    with torch.inference_mode():
+        source = torch.randn(1, 1029, 1024, device="cuda", dtype=torch.bfloat16)
+        q1, scale1 = cache.prepare_convrot_activation_cached(source, torch.bfloat16, 256)
+        q2, scale2 = cache.prepare_convrot_activation_cached(source, torch.bfloat16, 256)
+    assert q2.data_ptr() == q1.data_ptr()
+    assert scale2.data_ptr() == scale1.data_ptr()
+    assert cache.convrot_activation_cache_stats() == {"entries": 1, "hits": 1, "misses": 1}
diff --git a/tests/test_int8_prequantized.py b/tests/test_int8_prequantized.py
new file mode 100644
index 0000000..4a4d9fb
--- /dev/null
+++ b/tests/test_int8_prequantized.py
@@ -0,0 +1,47 @@
+import importlib
+from pathlib import Path
+import sys
+import types
+
+import pytest
+import torch
+
+
+ROOT = Path(__file__).resolve().parents[1]
+PACKAGE = "int8_fast_rocm_prequant_tests"
+if PACKAGE not in sys.modules:
+    package = types.ModuleType(PACKAGE)
+    package.__path__ = [str(ROOT)]
+    sys.modules[PACKAGE] = package
+
+kernel = importlib.import_module(f"{PACKAGE}.int8_fused_kernel")
+
+
+def _require_rocm():
+    if not torch.cuda.is_available() or torch.version.hip is None:
+        pytest.skip("requires a ROCm GPU")
+
+
+def test_trellis_static_configs_cover_known_shapes_only():
+    assert kernel._trellis_convrot_static_config(4096, 4608, 1536) == (128, 128, 32, 4, 4)
+    assert kernel._trellis_convrot_static_config(8398, 1536, 8192) == (128, 256, 64, 8, 3)
+    assert kernel._trellis_convrot_static_config(2875, 8192, 1536) == (64, 128, 32, 4, 4)
+    assert kernel._trellis_convrot_static_config(123, 777, 555) is None
+
+
+def test_prequantized_int8_linear_matches_dynamic_path():
+    _require_rocm()
+    m, n, k = 37, 192, 256
+    x = torch.randn(m, k, device="cuda", dtype=torch.bfloat16)
+    weight = torch.randint(-128, 128, (n, k), device="cuda", dtype=torch.int8)
+    weight_scale = torch.rand(n, 1, device="cuda", dtype=torch.float32) * 0.01
+    bias = torch.randn(n, device="cuda", dtype=torch.bfloat16)
+
+    expected = kernel.triton_int8_linear_per_row(
+        x, weight, weight_scale, bias, torch.bfloat16
+    )
+    x_int8, x_scale = kernel.triton_quantize_rowwise(x)
+    actual = kernel.triton_int8_linear_per_row_prequantized(
+        x_int8, x_scale, weight, weight_scale, bias, torch.bfloat16
+    )
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
