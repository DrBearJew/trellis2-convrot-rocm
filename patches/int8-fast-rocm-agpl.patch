+"""Bounded activation cache for reusable ConvRot preprocessing."""
+
+from collections import OrderedDict
+import weakref
+
+import torch
+from torch import Tensor, nn
+
+from .convrot import build_hadamard, rotate_activation
+from .int8_fused_kernel import triton_quantize_rowwise
+
+_CONVROT_ACTIVATION_CACHE = OrderedDict()
+_CONVROT_ACTIVATION_CACHE_MAX = 8
+_CONVROT_ACTIVATION_CACHE_HITS = 0
+_CONVROT_ACTIVATION_CACHE_MISSES = 0
+
+
+def _tensor_version(source: Tensor) -> int | None:
+    """Inference tensors are immutable by cache contract and have no version counter."""
+    try:
+        return int(source._version)
+    except RuntimeError:
+        return None
+
+
+def clear_convrot_activation_cache() -> None:
+    global _CONVROT_ACTIVATION_CACHE_HITS, _CONVROT_ACTIVATION_CACHE_MISSES
+    _CONVROT_ACTIVATION_CACHE.clear()
+    _CONVROT_ACTIVATION_CACHE_HITS = 0
+    _CONVROT_ACTIVATION_CACHE_MISSES = 0
+
+
+def convrot_activation_cache_stats() -> dict[str, int]:
+    return {
+        "entries": len(_CONVROT_ACTIVATION_CACHE),
+        "hits": _CONVROT_ACTIVATION_CACHE_HITS,
+        "misses": _CONVROT_ACTIVATION_CACHE_MISSES,
+    }
+
+
+def enable_convrot_context_cache(model: nn.Module) -> int:
+    """Mark cross-attention to_kv layers for shared ConvRot preprocessing."""
+    count = 0
+    for name, module in model.named_modules():
+        if name.endswith("cross_attn.to_kv") and getattr(module, "_use_convrot", False):
+            module._cache_convrot_activation = True
+            count += 1
+    return count
+
+
+def prepare_convrot_activation_cached(
+    source: Tensor,
+    compute_dtype: torch.dtype,
+    group_size: int,
+) -> tuple[Tensor, Tensor]:
+    """Rotate and row-quantize once per live tensor version and HIP stream.
+
+    Inference tensors have no version counter; callers must treat them as immutable,
+    which matches ComfyUI's inference-mode conditioning contract.
+    """
+    global _CONVROT_ACTIVATION_CACHE_HITS, _CONVROT_ACTIVATION_CACHE_MISSES
+    if source.device.type != "cuda":
+        raise ValueError("ConvRot activation caching requires a CUDA/HIP tensor")
+    key = (
+        id(source),
+        str(source.device),
+        int(torch.cuda.current_stream(source.device).cuda_stream),
+        source.dtype,
+        tuple(source.shape),
+        tuple(source.stride()),
+        int(source.storage_offset()),
+        compute_dtype,
+        int(group_size),
+    )
+    version = _tensor_version(source)
+    entry = _CONVROT_ACTIVATION_CACHE.get(key)
+    if entry is not None and entry[0]() is source and entry[1] == version:
+        _CONVROT_ACTIVATION_CACHE.move_to_end(key)
+        _CONVROT_ACTIVATION_CACHE_HITS += 1
+        return entry[2], entry[3]
+    if entry is not None:
+        _CONVROT_ACTIVATION_CACHE.pop(key, None)
+
+    x_2d = source.reshape(-1, source.shape[-1])
+    if x_2d.dtype != compute_dtype:
+        x_2d = x_2d.to(compute_dtype)
+    hadamard = build_hadamard(group_size, device=source.device, dtype=x_2d.dtype)
+    x_rotated = rotate_activation(x_2d, hadamard, group_size=group_size).contiguous()
+    x_int8, x_scale = triton_quantize_rowwise(x_rotated)
+
+    def remove_entry(source_ref, cache_key=key):
+        current = _CONVROT_ACTIVATION_CACHE.get(cache_key)
+        if current is not None and current[0] is source_ref:
+            _CONVROT_ACTIVATION_CACHE.pop(cache_key, None)
+
+    source_ref = weakref.ref(source, remove_entry)
+    _CONVROT_ACTIVATION_CACHE[key] = (source_ref, version, x_int8, x_scale)
+    _CONVROT_ACTIVATION_CACHE.move_to_end(key)
+    while len(_CONVROT_ACTIVATION_CACHE) > _CONVROT_ACTIVATION_CACHE_MAX:
+        _CONVROT_ACTIVATION_CACHE.popitem(last=False)
+    _CONVROT_ACTIVATION_CACHE_MISSES += 1
+    return x_int8, x_scale
