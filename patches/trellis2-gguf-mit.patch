+def manual_cast_condition(owner: nn.Module, key: str, tensor, dtype):
+    """Cache immutable conditioning casts for ConvRot models across diffusion steps."""
+    if (
+        not getattr(owner, "_cache_condition_casts", False)
+        or not isinstance(tensor, torch.Tensor)
+        or torch.is_autocast_enabled()
+        or tensor.dtype == dtype
+    ):
+        return manual_cast(tensor, dtype)
+
+    try:
+        version = int(tensor._version)
+    except RuntimeError:
+        version = None  # Inference tensors are immutable by contract.
+    cache = getattr(owner, "_condition_cast_cache", None)
+    if cache is None:
+        cache = {}
+        owner._condition_cast_cache = cache
+    cache_key = (key, str(tensor.device), dtype)
+    entry = cache.get(cache_key)
+    if entry is not None and entry[0]() is tensor and entry[1] == version:
+        return entry[2]
+
+    converted = tensor.to(dtype=dtype)
+
+    def remove_entry(source_ref, owner_ref=weakref.ref(owner), item_key=cache_key):
+        live_owner = owner_ref()
+        if live_owner is None:
+            return
+        live_cache = getattr(live_owner, "_condition_cast_cache", None)
+        current = live_cache.get(item_key) if live_cache is not None else None
+        if current is not None and current[0] is source_ref:
+            live_cache.pop(item_key, None)
+
+    source_ref = weakref.ref(tensor, remove_entry)
+    cache[cache_key] = (source_ref, version, converted)
+    return converted
+
