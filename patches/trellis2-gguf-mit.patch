+++ b/trellis2_gguf/utils/image_preprocess.py
@@ -0,0 +1,38 @@
+"""Shared RGB/RGBA preprocessing for TRELLIS image conditioning."""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+from PIL import Image
+
+
+def crop_and_premultiply_rgba(
+    input_image: Image.Image, *, maximum_size: int
+) -> Image.Image:
+    """Return square RGB conditioning while retaining any visible alpha."""
+    if maximum_size <= 0:
+        raise ValueError("maximum_size must be positive")
+    input_image = input_image.convert("RGBA")
+    scale = min(1.0, float(maximum_size) / max(input_image.size))
+    if scale < 1.0:
+        input_image = input_image.resize(
+            (int(input_image.width * scale), int(input_image.height * scale)),
+            Image.Resampling.LANCZOS,
+        )
+    alpha_bbox = input_image.getchannel("A").getbbox()
+    if alpha_bbox is None:
+        raise ValueError("TRELLIS preprocessing found no visible pixels")
+    left, upper, right, lower = alpha_bbox
+    side = max(1, right - left, lower - upper)
+    center_x = (left + right) / 2.0
+    center_y = (upper + lower) / 2.0
+    crop_left = math.floor(center_x - side / 2.0)
+    crop_upper = math.floor(center_y - side / 2.0)
+    input_image = input_image.crop(
+        (crop_left, crop_upper, crop_left + side, crop_upper + side)
+    )
+    rgba = np.asarray(input_image, dtype=np.float32) / 255.0
+    rgb = rgba[..., :3] * rgba[..., 3:4]
+    return Image.fromarray(np.clip(rgb * 255.0, 0, 255).astype(np.uint8), mode="RGB")
