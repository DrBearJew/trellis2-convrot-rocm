+        scene_extras = scenes[scene_index].setdefault("extras", {})
+        scene_extras.update(
+            {
+                "trellis_export_contract": "convrot-rocm-0.1.2",
+                "trellis_trimesh_version": str(Trimesh.__version__),
+                "trellis_coordinate_space": "normalized",
+                "trellis_physical_scale_authorized": False,
+            }
+        )
+    for mesh in tree.get("meshes", []):
+        mesh_extras = mesh.setdefault("extras", {})
+        mesh_extras.update(
+            {
+                "trellis_normal_semantic": "NORMAL",
+                "trellis_coordinate_space": "normalized",
+                "trellis_physical_scale_authorized": False,
+            }
+        )
+    for node in tree.get("nodes", []):
+        if "mesh" in node:
+            node.setdefault("extras", {})["trellis_role"] = "generated-reference"
+    for material_index, material in enumerate(materials):
+        material.setdefault("name", "TRELLIS_PBR_MetallicRoughness")
+        material.setdefault("extras", {}).update(
+            {
+                "trellis_pbr_layout": "baseColor+metallicRoughness",
+                "trellis_metallic_channel": "B",
+                "trellis_roughness_channel": "G",
+            }
+        )
+        pbr = material.get("pbrMetallicRoughness", {})
+        suffix = "" if len(materials) == 1 else f"_{material_index}"
+        for key, role in (
+            ("baseColorTexture", "TRELLIS_BaseColor"),
+            ("metallicRoughnessTexture", "TRELLIS_MetallicRoughness"),
+        ):
+            reference = pbr.get(key)
+            if not isinstance(reference, dict):
+                continue
+            texture_index = reference.get("index")
+            if not isinstance(texture_index, int) or not 0 <= texture_index < len(textures):
+                continue
+            name = f"{role}{suffix}"
+            textures[texture_index].setdefault("name", name)
+            image_index = textures[texture_index].get("source")
+            if isinstance(image_index, int) and 0 <= image_index < len(images):
+                images[image_index].setdefault("name", name)
