+"""ROCm-safe UV rasterization implemented with ordinary PyTorch operations."""
+
+from __future__ import annotations
+
+import torch
+
+
+def rasterize_uv_positions(
+    vertices: torch.Tensor,
+    faces: torch.Tensor,
+    uvs: torch.Tensor,
+    texture_size: int,
+    *,
+    face_chunk_size: int = 16384,
+    candidate_chunk_size: int = 1 << 20,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return a texture coverage mask and interpolated 3D positions.
+
+    Triangles in a UV atlas do not overlap except at chart boundaries, so a
+    triangle-driven rasterizer is both bounded and sufficient for texture
+    baking. Pixel centers use the conventional ``uv * size - 0.5`` mapping.
+    """
+    if vertices.ndim != 2 or vertices.shape[1] != 3:
+        raise ValueError("vertices must have shape [N, 3]")
+    if faces.ndim != 2 or faces.shape[1] != 3:
+        raise ValueError("faces must have shape [F, 3]")
+    if uvs.ndim != 2 or uvs.shape[1] != 2 or uvs.shape[0] != vertices.shape[0]:
+        raise ValueError("uvs must have shape [N, 2] and match vertices")
+    if texture_size <= 0 or face_chunk_size <= 0 or candidate_chunk_size <= 0:
+        raise ValueError(
+            "texture_size, face_chunk_size, and candidate_chunk_size must be positive"
+        )
+    if vertices.device != faces.device or vertices.device != uvs.device:
+        raise ValueError("vertices, faces, and uvs must share a device")
+
+    faces_long = faces.to(torch.int64)
+    triangle_uvs = uvs[faces_long] * texture_size - 0.5
+    lower = torch.floor(triangle_uvs.amin(dim=1)).to(torch.int64)
+    upper = torch.ceil(triangle_uvs.amax(dim=1)).to(torch.int64)
+    lower.clamp_(0, texture_size - 1)
+    upper.clamp_(0, texture_size - 1)
+    extents = (upper - lower + 1).clamp_min_(0)
+    candidate_counts = extents[:, 0] * extents[:, 1]
+
+    flat_mask = torch.zeros(
+        texture_size * texture_size, dtype=torch.bool, device=vertices.device
+    )
+    flat_positions = torch.zeros(
+        texture_size * texture_size,
+        3,
+        dtype=vertices.dtype,
+        device=vertices.device,
+    )
+
+    for start in range(0, faces.shape[0], face_chunk_size):
+        end = min(start + face_chunk_size, faces.shape[0])
+        counts = candidate_counts[start:end]
+        candidate_ends = torch.cumsum(counts, dim=0)
+        candidate_total = int(candidate_ends[-1].item()) if len(counts) else 0
+        if candidate_total == 0:
+            continue
+        candidate_starts = candidate_ends - counts
+
+        # Face chunks bound triangle metadata; candidate chunks also bound the
+        # pixel tensors when one UV triangle spans most of a large atlas.
+        for candidate_start in range(0, candidate_total, candidate_chunk_size):
+            candidate_end = min(candidate_start + candidate_chunk_size, candidate_total)
+            candidate_ids = torch.arange(
+                candidate_start,
+                candidate_end,
+                dtype=torch.int64,
+                device=vertices.device,
+            )
+            local_face_ids = torch.searchsorted(
+                candidate_ends, candidate_ids, right=True
+            )
+            face_ids = local_face_ids + start
+            local_ids = candidate_ids - candidate_starts[local_face_ids]
+
+            widths = extents[face_ids, 0]
+            x = lower[face_ids, 0] + local_ids % widths
+            y = lower[face_ids, 1] + local_ids // widths
+            triangles = triangle_uvs[face_ids]
+            px = x.to(triangles.dtype)
+            py = y.to(triangles.dtype)
+
+            denominator = (
+                (triangles[:, 1, 1] - triangles[:, 2, 1])
+                * (triangles[:, 0, 0] - triangles[:, 2, 0])
+                + (triangles[:, 2, 0] - triangles[:, 1, 0])
+                * (triangles[:, 0, 1] - triangles[:, 2, 1])
+            )
+            nondegenerate = denominator.abs() > 1e-12
+            safe_denominator = torch.where(
+                nondegenerate, denominator, torch.ones_like(denominator)
+            )
+            weight_0 = (
+                (triangles[:, 1, 1] - triangles[:, 2, 1])
+                * (px - triangles[:, 2, 0])
+                + (triangles[:, 2, 0] - triangles[:, 1, 0])
+                * (py - triangles[:, 2, 1])
+            ) / safe_denominator
+            weight_1 = (
+                (triangles[:, 2, 1] - triangles[:, 0, 1])
+                * (px - triangles[:, 2, 0])
+                + (triangles[:, 0, 0] - triangles[:, 2, 0])
+                * (py - triangles[:, 2, 1])
+            ) / safe_denominator
+            barycentric = torch.stack(
+                (weight_0, weight_1, 1 - weight_0 - weight_1), dim=1
+            )
+            inside = (
+                nondegenerate
+                & (barycentric.amin(dim=1) >= -1e-5)
+                & (barycentric.amax(dim=1) <= 1.00001)
+            )
+            if not bool(inside.any()):
+                continue
+
+            covered_faces = face_ids[inside]
+            covered_pixels = (y[inside] * texture_size + x[inside]).to(torch.int64)
+            triangle_positions = vertices[faces_long[covered_faces]]
+            sampled_positions = (
+                barycentric[inside].to(vertices.dtype).unsqueeze(-1)
+                * triangle_positions
+            ).sum(dim=1)
+            flat_mask[covered_pixels] = True
+            flat_positions[covered_pixels] = sampled_positions
+
+    mask = flat_mask.view(texture_size, texture_size)
+    return mask, flat_positions[flat_mask]
