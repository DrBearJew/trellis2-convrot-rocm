index 0000000000000000000000000000000000000000..69fdbe1957ecb27c8f3425d3b0381698cb349b2c
--- /dev/null
+++ b/trellis2_gguf/utils/convrot_utils.py
@@ -0,0 +1,485 @@
+"""TRELLIS-native loader and linear adapters for combined ConvRot W8A8 checkpoints."""
+
+from __future__ import annotations
+
+import importlib
+from functools import lru_cache
+import json
+import logging
+import os
+from pathlib import Path
+import struct
+import sys
+import types
+from typing import Any
+
+import torch
+from torch import Tensor, nn
+import torch.nn.functional as F
+logger = logging.getLogger(__name__)
+
+_BACKEND_PACKAGE = "_trellis2_int8_fast_rocm"
+_STRUCTURE_BASENAME = "ss_flow_img_dit_1_3B_64_bf16"
+_SHAPE_512_BASENAME = "slat_flow_img2shape_dit_1_3B_512_bf16"
+_SHAPE_1024_BASENAME = "slat_flow_img2shape_dit_1_3B_1024_bf16"
+_TEXTURE_512_BASENAME = "slat_flow_imgshape2tex_dit_1_3B_512_bf16"
+_TEXTURE_1024_BASENAME = "slat_flow_imgshape2tex_dit_1_3B_1024_bf16"
+
+
+def get_convrot_checkpoint() -> str:
+    configured = os.environ.get("TRELLIS2_CONVROT_CHECKPOINT")
+    if configured:
+        return configured
+    import folder_paths
+    return os.path.join(
+        folder_paths.models_dir,
+        "diffusion_models",
+        "trellis_2_int8_convrot.safetensors",
+    )
+
+
+@lru_cache(maxsize=8)
+def _checkpoint_layout(checkpoint: str) -> tuple[frozenset[str], str | None]:
+    with open(checkpoint, "rb", buffering=0) as handle:
+        header_size = struct.unpack("<Q", handle.read(8))[0]
+        header = json.loads(handle.read(header_size))
+    components = frozenset(
+        key.split(".", 2)[1]
+        for key in header
+        if key.startswith("model.") and key.count(".") >= 2
+    )
+    metadata = header.get("__metadata__") or {}
+    return components, metadata.get("contract")
+
+
+def checkpoint_prefix_for_path(path: str, checkpoint: str) -> str:
+    """Resolve a pipeline model path against the components actually in a checkpoint."""
+    basename = os.path.basename(path.rstrip("/\\"))
+    components, contract = _checkpoint_layout(os.path.realpath(checkpoint))
+    if basename == _STRUCTURE_BASENAME:
+        candidates = ("structure_model",)
+    elif basename == _SHAPE_512_BASENAME:
+        candidates = ("img2shape_512",)
+    elif basename == _SHAPE_1024_BASENAME:
+        candidates = ("img2shape_1024", "img2shape")
+    elif basename == _TEXTURE_512_BASENAME:
+        # The locally rebuilt v1 contract uses shape2txt for the 512 texture flow.
+        candidates = ("shape2txt_512", "shape2txt") if contract == "trellis2-convrot-v1" else ("shape2txt_512",)
+    elif basename == _TEXTURE_1024_BASENAME:
+        # BitPoet's verified four-component artifact uses legacy shape2txt here.
+        candidates = ("shape2txt_1024", "shape2txt") if contract != "trellis2-convrot-v1" else ("shape2txt_1024",)
+    else:
+        raise ValueError(f"No ConvRot checkpoint mapping is defined for {basename!r}")
+    for candidate in candidates:
+        if candidate in components:
+            return candidate
+    raise KeyError(
+        f"Checkpoint {checkpoint} has no ConvRot component for {basename!r}; "
+        f"available components are {sorted(components)}"
+    )
+
+
+def find_model_config(path: str) -> str:
+    """Find the non-SDNQ architecture JSON corresponding to a pipeline model path."""
+    candidate = Path(path + ".json")
+    if candidate.is_file():
+        return str(candidate)
+    basename = os.path.basename(path.rstrip("/\\")) + ".json"
+    model_root = Path(path).parent.parent
+    matches = [
+        item for item in model_root.rglob(basename)
+        if "sdnq" not in {part.lower() for part in item.parts}
+    ]
+    if len(matches) != 1:
+        raise FileNotFoundError(
+            f"Expected one architecture config named {basename} below {model_root}, found {matches}"
+        )
+    return str(matches[0])
+
+
+def _find_backend_root() -> Path:
+    configured = os.environ.get("TRELLIS2_INT8_FAST_PATH")
+    candidates = []
+    if configured:
+        candidates.append(Path(configured))
+    custom_nodes = Path(__file__).resolve().parents[3]
+    candidates.append(custom_nodes / "ComfyUI-INT8-Fast-ROCM")
+    candidates.append(custom_nodes.parent.parent / "sources" / "ComfyUI-INT8-Fast-ROCM")
+    for candidate in candidates:
+        if (candidate / "int8_fused_kernel.py").is_file() and (candidate / "convrot.py").is_file():
+            return candidate.resolve()
+    raise FileNotFoundError(
+        "ComfyUI-INT8-Fast-ROCM was not found; set TRELLIS2_INT8_FAST_PATH to its source directory"
+    )
+
+
+def _ensure_backend_package() -> None:
+    if _BACKEND_PACKAGE not in sys.modules:
+        package = types.ModuleType(_BACKEND_PACKAGE)
+        package.__path__ = [str(_find_backend_root())]
+        package.__package__ = _BACKEND_PACKAGE
+        sys.modules[_BACKEND_PACKAGE] = package
+
+
+def _load_rotation_module():
+    _ensure_backend_package()
+    return importlib.import_module(f"{_BACKEND_PACKAGE}.convrot")
+
+
+def _load_triton_backend_modules():
+    """Load optional Triton acceleration without hiding unrelated import defects."""
+    _ensure_backend_package()
+    try:
+        kernel = importlib.import_module(f"{_BACKEND_PACKAGE}.int8_fused_kernel")
+        cache = importlib.import_module(f"{_BACKEND_PACKAGE}.convrot_cache")
+    except ModuleNotFoundError as exc:
+        if exc.name != "triton" and not str(exc.name).startswith("triton."):
+            raise
+        return None, None
+    return kernel, cache
+
+
+class ConvRotLinear(nn.Module):
+    """Linear layer backed by pre-rotated INT8 weights and per-output-row scales."""
+
+    def __init__(
+        self,
+        in_features: int,
+        out_features: int,
+        *,
+        bias: bool,
+        sparse: bool,
+        cache_context: bool,
+        group_size: int = 256,
+        device: str | torch.device = "meta",
+    ) -> None:
+        super().__init__()
+        self.in_features = int(in_features)
+        self.out_features = int(out_features)
+        self.sparse = bool(sparse)
+        self.cache_context = bool(cache_context)
+        self.group_size = int(group_size)
+        if self.in_features % self.group_size:
+            raise ValueError(
+                f"ConvRot in_features {self.in_features} is not divisible by group size {self.group_size}"
+            )
+        self.weight = nn.Parameter(
+            torch.empty((self.out_features, self.in_features), dtype=torch.int8, device=device),
+            requires_grad=False,
+        )
+        self.register_buffer(
+            "weight_scale",
+            torch.empty((self.out_features, 1), dtype=torch.float32, device=device),
+        )
+        self.bias = (
+            nn.Parameter(torch.empty(self.out_features, dtype=torch.bfloat16, device=device), requires_grad=False)
+            if bias
+            else None
+        )
+
+    def _forward_tensor(self, source: Tensor) -> Tensor:
+        convrot = _load_rotation_module()
+        kernel, cache = _load_triton_backend_modules()
+        original_shape = source.shape
+        compute_dtype = source.dtype if source.dtype in (torch.float16, torch.bfloat16) else torch.bfloat16
+
+        if kernel is not None and source.device.type == "cuda" and self.cache_context:
+            x_int8, x_scale = cache.prepare_convrot_activation_cached(
+                source, compute_dtype, self.group_size
+            )
+            output = kernel.triton_int8_linear_per_row_prequantized(
+                x_int8,
+                x_scale,
+                self.weight,
+                self.weight_scale,
+                self.bias,
+                compute_dtype,
+                trellis_static=True,
+            )
+        else:
+            x_2d = source.reshape(-1, original_shape[-1]).to(compute_dtype)
+            hadamard = convrot.build_hadamard(
+                self.group_size, device=source.device, dtype=compute_dtype
+            )
+            rotated = convrot.rotate_activation(x_2d, hadamard, self.group_size).contiguous()
+            if kernel is not None and source.device.type == "cuda":
+                output = kernel.triton_int8_linear_per_row(
+                    rotated,
+                    self.weight,
+                    self.weight_scale,
+                    self.bias,
+                    compute_dtype,
+                )
+            else:
+                dequant_weight = self.weight.to(torch.float32) * self.weight_scale
+                output = F.linear(
+                    rotated.to(torch.float32),
+                    dequant_weight,
+                    self.bias.to(torch.float32) if self.bias is not None else None,
+                ).to(compute_dtype)
+        return output.reshape(*original_shape[:-1], self.out_features)
+
+    def forward(self, source):
+        if self.sparse:
+            return source.replace(self._forward_tensor(source.feats))
+        return self._forward_tensor(source)
+
+    def extra_repr(self) -> str:
+        return (
+            f"in_features={self.in_features}, out_features={self.out_features}, "
+            f"bias={self.bias is not None}, sparse={self.sparse}, "
+            f"cache_context={self.cache_context}, group_size={self.group_size}"
+        )
+
+
+def _parse_quant_record(raw: Tensor, key: str) -> dict[str, Any]:
+    try:
+        record = json.loads(bytes(raw.tolist()).decode("utf-8"))
+    except Exception as exc:
+        raise ValueError(f"Invalid comfy_quant record {key}") from exc
+    if record.get("format") != "int8_tensorwise" or record.get("convrot") is not True:
+        raise ValueError(f"Unsupported ConvRot quantization record {key}: {record}")
+    group_size = int(record.get("convrot_groupsize", 0))
+    if group_size <= 0:
+        raise ValueError(f"Invalid ConvRot group size in {key}: {group_size}")
+    return record
+
+
+def load_component_state(
+    checkpoint: str,
+    component_prefix: str,
+) -> tuple[dict[str, Tensor], dict[str, dict[str, Any]]]:
+    """Bulk-read one component's four contiguous dtype runs from the combined file.
+
+    Per-tensor mmap faults on NTFS/FUSE cost roughly one second each. The combined
+    checkpoint stores each component in four contiguous F32/BF16/I8/U8 runs, so
+    four sequential reads eliminate that pathological GPU-materialization cost.
+    """
+    outer = f"model.{component_prefix}."
+    with open(checkpoint, "rb", buffering=0) as handle:
+        file_size = os.path.getsize(checkpoint)
+        header_size = struct.unpack("<Q", handle.read(8))[0]
+        if header_size <= 0 or header_size > file_size - 8:
+            raise ValueError(f"Invalid safetensors header size {header_size} in {checkpoint}")
+        header = json.loads(handle.read(header_size))
+        data_start = 8 + header_size
+        items = []
+        for key, record in header.items():
+            if key == "__metadata__" or not key.startswith(outer):
+                continue
+            start, end = map(int, record["data_offsets"])
+            if start < 0 or end < start or data_start + end > file_size:
+                raise ValueError(f"Invalid safetensors range {start}:{end} for {key}")
+            items.append((start, end, key, record))
+        if not items:
+            raise KeyError(f"Checkpoint {checkpoint} has no component {component_prefix!r}")
+        items.sort(key=lambda item: item[0])
+
+        runs = []
+        run_start = items[0][0]
+        run_end = items[0][1]
+        for start, end, _, _ in items[1:]:
+            if start == run_end:
+                run_end = end
+            else:
+                runs.append((run_start, run_end))
+                run_start, run_end = start, end
+        runs.append((run_start, run_end))
+        if len(runs) != 4:
+            raise ValueError(f"Expected four contiguous ConvRot dtype runs, found {runs}")
+
+        buffers = []
+        for start, end in runs:
+            buffer = bytearray(end - start)
+            handle.seek(data_start + start)
+            if handle.readinto(buffer) != len(buffer):
+                raise EOFError(f"Short read for ConvRot range {start}:{end}")
+            buffers.append((start, end, buffer))
+
+    dtype_map = {
+        "F32": torch.float32,
+        "BF16": torch.bfloat16,
+        "I8": torch.int8,
+        "U8": torch.uint8,
+    }
+    state: dict[str, Tensor] = {}
+    quant_records: dict[str, dict[str, Any]] = {}
+    for start, end, key, record in items:
+        dtype_name = record["dtype"]
+        if dtype_name not in dtype_map:
+            raise ValueError(f"Unsupported dtype {dtype_name} in {key}")
+        owner_start, _, owner = next(run for run in buffers if run[0] <= start and end <= run[1])
+        shape = tuple(int(dim) for dim in record["shape"])
+        count = 1
+        for dim in shape:
+            count *= dim
+        dtype = dtype_map[dtype_name]
+        expected_bytes = count * torch.empty((), dtype=dtype).element_size()
+        if end - start != expected_bytes:
+            raise ValueError(f"Safetensors byte-size mismatch for {key}")
+        tensor = torch.frombuffer(
+            owner,
+            dtype=dtype,
+            count=count,
+            offset=start - owner_start,
+        ).reshape(shape)
+        local_key = key[len(outer):]
+        if local_key.endswith(".comfy_quant"):
+            module_name = local_key[: -len(".comfy_quant")]
+            quant_records[module_name] = _parse_quant_record(tensor, key)
+        else:
+            state[local_key] = tensor
+    return state, quant_records
+
+
+def load_owned_safetensors(checkpoint: str) -> dict[str, Tensor]:
+    """Load a complete safetensors file with one sequential read into owned RAM."""
+    dtype_map = {
+        "F64": torch.float64,
+        "F32": torch.float32,
+        "F16": torch.float16,
+        "BF16": torch.bfloat16,
+        "I64": torch.int64,
+        "I32": torch.int32,
+        "I16": torch.int16,
+        "I8": torch.int8,
+        "U8": torch.uint8,
+        "BOOL": torch.bool,
+    }
+    with open(checkpoint, "rb", buffering=0) as handle:
+        file_size = os.path.getsize(checkpoint)
+        header_size = struct.unpack("<Q", handle.read(8))[0]
+        if header_size <= 0 or header_size > file_size - 8:
+            raise ValueError(f"Invalid safetensors header size {header_size} in {checkpoint}")
+        header = json.loads(handle.read(header_size))
+        records = [record for key, record in header.items() if key != "__metadata__"]
+        if not records:
+            raise ValueError(f"No tensors in {checkpoint}")
+        data_size = max(int(record["data_offsets"][1]) for record in records)
+        if 8 + header_size + data_size > file_size:
+            raise ValueError(f"Safetensors data range exceeds file size in {checkpoint}")
+        owner = bytearray(data_size)
+        if handle.readinto(owner) != data_size:
+            raise EOFError(f"Short read for {checkpoint}")
+
+    state = {}
+    for key, record in header.items():
+        if key == "__metadata__":
+            continue
+        dtype_name = record["dtype"]
+        if dtype_name not in dtype_map:
+            raise ValueError(f"Unsupported dtype {dtype_name} in {key}")
+        shape = tuple(int(dim) for dim in record["shape"])
+        count = 1
+        for dim in shape:
+            count *= dim
+        start, end = map(int, record["data_offsets"])
+        dtype = dtype_map[dtype_name]
+        expected_bytes = count * torch.empty((), dtype=dtype).element_size()
+        if start < 0 or end < start or end - start != expected_bytes or end > len(owner):
+            raise ValueError(f"Invalid safetensors range for {key}: {start}:{end}")
+        state[key] = torch.frombuffer(
+            owner, dtype=dtype, count=count, offset=start
+        ).reshape(shape)
+    return state
+
+
+def replace_convrot_linears(
+    model: nn.Module,
+    state: dict[str, Tensor],
+    quant_records: dict[str, dict[str, Any]],
+) -> int:
+    """Replace every manifest-targeted torch/Sparse linear before assigning checkpoint tensors."""
+    from ..modules.sparse.linear import SparseLinear
+
+    replaced = 0
+    for module_name, record in quant_records.items():
+        parent_name, _, child_name = module_name.rpartition(".")
+        parent = model.get_submodule(parent_name) if parent_name else model
+        original = getattr(parent, child_name)
+        if not isinstance(original, nn.Linear):
+            raise TypeError(f"ConvRot target {module_name} is not a Linear: {type(original).__name__}")
+        weight_key = f"{module_name}.weight"
+        scale_key = f"{module_name}.weight_scale"
+        if weight_key not in state or state[weight_key].dtype != torch.int8:
+            raise ValueError(f"Missing INT8 weight for {module_name}")
+        if scale_key not in state or state[scale_key].dtype != torch.float32:
+            raise ValueError(f"Missing FP32 row scales for {module_name}")
+        expected_shape = (original.out_features, original.in_features)
+        if tuple(state[weight_key].shape) != expected_shape:
+            raise ValueError(
+                f"ConvRot shape mismatch for {module_name}: {tuple(state[weight_key].shape)} != {expected_shape}"
+            )
+        replacement = ConvRotLinear(
+            original.in_features,
+            original.out_features,
+            bias=original.bias is not None,
+            sparse=isinstance(original, SparseLinear),
+            cache_context=module_name.endswith("cross_attn.to_kv"),
+            group_size=int(record["convrot_groupsize"]),
+            device="meta",
+        )
+        setattr(parent, child_name, replacement)
+        replaced += 1
+    return replaced
+
+
+def _materialize_rope_phases(model: nn.Module) -> None:
+    rope_phases = getattr(model, "rope_phases", None)
+    if rope_phases is None or not rope_phases.is_meta:
+        return
+    from ..modules.attention.rope import RotaryPositionEmbedder
+
+    resolution = int(model.resolution)
+    embedder = RotaryPositionEmbedder(model.model_channels // model.num_heads, 3)
+    coords = torch.meshgrid(
+        *[torch.arange(resolution) for _ in range(3)], indexing="ij"
+    )
+    coords = torch.stack(coords, dim=-1).reshape(-1, 3)
+    model.rope_phases = embedder(coords)
+
+
+def _materialize_sparse_rope_freqs(model: nn.Module) -> None:
+    for module in model.modules():
+        freqs = getattr(module, "freqs", None)
+        if isinstance(freqs, Tensor) and freqs.is_meta and hasattr(module, "freq_dim"):
+            values = torch.arange(module.freq_dim, dtype=torch.float32) / module.freq_dim
+            module.freqs = module.rope_freq[0] / (module.rope_freq[1] ** values)
+
+
+def load_convrot_model(
+    *,
+    model_class,
+    config: dict[str, Any],
+    checkpoint: str,
+    component_prefix: str,
+    model_kwargs: dict[str, Any] | None = None,
+) -> nn.Module:
+    """Build a TRELLIS model on meta, replace 210 linears, and assign one checkpoint component."""
+    if not os.path.isfile(checkpoint):
+        raise FileNotFoundError(checkpoint)
+    state, quant_records = load_component_state(checkpoint, component_prefix)
+    kwargs = {**config["args"], **(model_kwargs or {})}
+    with torch.device("meta"):
+        model = model_class(**kwargs)
+    replaced = replace_convrot_linears(model, state, quant_records)
+    if replaced != len(quant_records) or replaced != 210:
+        raise ValueError(
+            f"Expected exactly 210 ConvRot linears for {component_prefix}, replaced {replaced} of {len(quant_records)}"
+        )
+    incompatible = model.load_state_dict(state, strict=False, assign=True)
+    _materialize_rope_phases(model)
+    _materialize_sparse_rope_freqs(model)
+    missing = [key for key in incompatible.missing_keys if not key.endswith("rope_phases")]
+    if missing or incompatible.unexpected_keys:
+        raise ValueError(
+            f"ConvRot state mismatch for {component_prefix}: missing={missing}, unexpected={incompatible.unexpected_keys}"
+        )
+    meta = [name for name, tensor in list(model.named_parameters()) + list(model.named_buffers()) if tensor.is_meta]
+    if meta:
+        raise ValueError(f"ConvRot model retained meta tensors: {meta}")
+    model._convrot_component_prefix = component_prefix
+    model._convrot_checkpoint = checkpoint
+    model._cache_condition_casts = True
+    logger.info("Loaded %s with %d ConvRot linears", component_prefix, replaced)
+    return model
