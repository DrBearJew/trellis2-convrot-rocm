+_NVDR_GL_CONTEXT = None
+_NVDR_GL_CONTEXT_LOCK = threading.Lock()
+
+
+def _get_nvdr_gl_context():
+    """Create and reuse the native OpenGL context on CUDA builds."""
+    global _NVDR_GL_CONTEXT
+    if _NVDR_GL_CONTEXT is None:
+        with _NVDR_GL_CONTEXT_LOCK:
+            if _NVDR_GL_CONTEXT is None:
+                _NVDR_GL_CONTEXT = dr.RasterizeGLContext()
+    return _NVDR_GL_CONTEXT
+
+
+def _rasterize_uv_positions(vertices, faces, uvs, texture_size):
+    """Rasterize UVs and return the covered mask plus interpolated positions."""
+    faces = faces.to(torch.int32)
+    if torch.version.hip is not None:
+        from .trellis2_gguf.utils.uv_rasterizer import rasterize_uv_positions
+
+        return rasterize_uv_positions(vertices, faces, uvs, texture_size)
+
+    clip_uvs = torch.cat(
+        [uvs * 2 - 1, torch.zeros_like(uvs[:, :1]), torch.ones_like(uvs[:, :1])],
+        dim=-1,
+    ).unsqueeze(0)
+    ctx = _get_nvdr_gl_context()
+    rast = torch.zeros(
+        (1, texture_size, texture_size, 4), device=vertices.device, dtype=torch.float32
+    )
+    for index in range(0, faces.shape[0], 100000):
+        rast_chunk, _ = dr.rasterize(
+            ctx,
+            clip_uvs,
+            faces[index:index + 100000],
+            resolution=[texture_size, texture_size],
+        )
+        mask_chunk = rast_chunk[..., 3:4] > 0
+        rast_chunk[..., 3:4] += index
+        rast = torch.where(mask_chunk, rast_chunk, rast)
+    mask = rast[0, ..., 3] > 0
+    positions = dr.interpolate(vertices.unsqueeze(0), rast, faces)[0][0]
+    return mask, positions[mask]
+
